{
  "name": "sunnysideup/age-field",
  "description": "Allows you to add an age field to any form (also has an EditableFormField version).",
  "type": "silverstripe-vendormodule",
  "keywords": [
    "age",
    "form",
    "fields",
    "form field",
    "age validation",
    "age restriction",
    "editable form field",
    "userforms",
    "userd defined forms",
    "how old am I"
  ],
  "license": "BSD-3-Clause",
  "require": {
    "silverstripe/framework": "^6.0",
    "silverstripe/admin": "^3.0"
  },
  "require-dev": {
  },
  "autoload": {
    "psr-4": {
      "Sunnysideup\\AgeField\\": "src/"
    }
  },
  "extra": {
    "expose": [
      "client/dist"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "bin": [
    "bin/sake-npm-build-age-field.sh",
    "bin/sake-npm-watch-age-field.sh"
  ],
  "authors": [
    {
      "name": "Nicolaas Thiemen Francken",
      "email": "modules@sunnysideup.co.nz",
      "role": "lead developer"
    }
  ]
}
